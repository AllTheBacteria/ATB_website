---
import Default from '@astrojs/starlight/components/PageTitle.astro';

// Hextra-style breadcrumb trail above the title, docs pages only.
// The docs are a flat list, so the trail is always Documentation → page.
const { entry } = Astro.locals.starlightRoute;
const isDocs = entry.id.startsWith('docs/');
// The homepage opens README-style with its tagline heading; the site
// name is already in the navbar, so skip the h1 there entirely. The
// data browser (/browse) brings its own app header, so skip it there too.
const hasOwnTitle = ['index', '', 'browse'].includes(entry.id);
---

{
	isDocs && (
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/docs/">Documentation</a>
			<svg
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="m9 18 6-6-6-6" />
			</svg>
			<span aria-current="page">{entry.data.title}</span>
		</nav>
	)
}
{!hasOwnTitle && <Default />}

<style>
	.breadcrumbs {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		/* Baseline-align with the sidebar's first link: the sidebar offsets
		   its text by 1rem pane padding + 0.4em link padding, while our
		   containing content panel pads 1.5rem — compensate the difference. */
		margin-top: calc(0.4em - 0.5rem);
		font-size: var(--sl-text-sm);
		line-height: 1.4; /* same as sidebar links, so baselines match */
	}
	.breadcrumbs a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.breadcrumbs a:hover {
		color: var(--sl-color-white);
	}
	.breadcrumbs svg {
		width: 0.875rem;
		height: 0.875rem;
		color: var(--sl-color-gray-4);
	}
	.breadcrumbs span {
		color: var(--sl-color-white);
	}
</style>
