---
// Mounts an atb-explorer runtime-module embed (that repo's
// docs/adr/2026-08-26-2230-starlight-module-embed.md): the cascade
// layer-order pin, the bundle stylesheet, a .not-content mount div, and the
// mount script. Deliberately blank while the module loads; `errorText`
// appears only on failure (pass '' to fail silently). Used by the /browse
// page (data browser) and the homepage (map widget).
interface Props {
	js: string;
	css: string;
	assetBase: string;
	id: string;
	errorText?: string;
}
const { js, css, assetBase, id, errorText = '' } = Astro.props;
---

{/* Pin the cascade-layer order before the bundle stylesheet parses:
    Starlight's layers, then the site theme (`atb`), then the bundle's
    Tailwind layers on top. `properties` (Tailwind's --tw-* fallback
    resets) must rank below `utilities`, or shadows/transforms zero out in
    some browsers. Keep the starlight/atb prefix identical to custom.css's
    declaration; duplicate pins on one page are harmless. */}
<style
	is:inline
	set:html={'@layer properties, starlight.base, starlight.reset, starlight.core, starlight.content, starlight.components, starlight.utils, atb, theme, base, components, utilities;'}
/>
<link rel="stylesheet" href={css} />
<div id={id} class="not-content"></div>
<script type="module" define:vars={{ js, assetBase, id, errorText }}>
	const el = document.getElementById(id);
	try {
		const { mount } = await import(js);
		mount(el, { assetBase });
	} catch (error) {
		console.error('Failed to load embed', js, error);
		if (errorText) {
			const status = document.createElement('p');
			status.className = 'atb-embed-error';
			status.textContent = errorText;
			el.replaceChildren(status);
		}
	}
</script>
<style is:global>
	/* Global (not scoped): the error element is created from the script. */
	.atb-embed-error {
		padding: 2rem 1.5rem;
		color: var(--sl-color-gray-3);
	}
</style>
