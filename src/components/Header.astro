---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

// Hextra-style top-level navigation: site sections live in the navbar,
// the sidebar is reserved for docs-internal navigation.
const links = [
	// Same destination as the site title; some visitors look for an
	// explicit "Home" in the nav.
	{ label: 'Home', href: '/' },
	{ label: 'Browse data', href: '/browse/' },
	{ label: 'Resources', href: '/resources/' },
	{ label: 'Docs', href: '/docs/', section: '/docs' },
];

const { pathname } = Astro.url;
// Prefix-match sections; "/" would prefix-match everything, so exact-match it.
const isActive = (link: (typeof links)[number]) =>
	link.href === '/'
		? pathname === '/'
		: pathname.startsWith(link.section ?? link.href);

// Splash pages have no sidebar drawer, so Starlight renders no menu
// button there; provide our own compact site menu on small screens.
// Docs pages get the site links inside the drawer instead (see the
// `md:sl-hidden` sidebar entries in astro.config.mjs).
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="top-nav sl-hidden md:sl-flex" aria-label="Main">
		{
			links.map((link) => (
				<a href={link.href} aria-current={isActive(link) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="search-wrapper sl-flex print:hidden">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
	</div>
	{
		!hasSidebar && (
			<details class="site-menu md:sl-hidden print:hidden">
				<summary aria-label="Menu">
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<path d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</summary>
				<nav aria-label="Main">
					<ul>
						{links.map((link) => (
							<li>
								<a href={link.href} aria-current={isActive(link) ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</details>
		)
	}
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		overflow: clip;
		/* Avoid clipping focus ring around link inside title wrapper. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.top-nav {
		gap: 1.5rem;
		align-items: center;
		/* Optical baseline alignment with the title text; real flex baseline
		   alignment would key off the logo <img> instead. ~2px is the
		   computed baseline gap between the two centered text sizes. */
		transform: translateY(2px);
	}
	.top-nav a {
		color: var(--sl-color-gray-3);
		/* Between --sl-text-sm (0.875rem) and --sl-text-base (1rem). */
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.top-nav a:hover,
	.top-nav a[aria-current='page'] {
		color: var(--sl-color-white);
	}

	/* Nav links sit left, next to the title; search and the icon group
	   are pushed to the trailing edge. */
	.search-wrapper {
		margin-inline-start: auto;
	}

	/* Show the site nav (and hide the splash hamburger) from 45rem, before
	   Starlight's 50rem `md` breakpoint; the docs sidebar drawer keeps
	   50rem, so 45–50rem docs pages show nav links plus the (docs-nav)
	   hamburger. Sync with the drawer-entry rule in custom.css. */
	@media (min-width: 45rem) {
		.top-nav,
		.right-group {
			display: flex;
		}
		.site-menu {
			display: none;
		}
	}
	/* Ghost search trigger: keep the label and ⌘K hint but drop the
	   input-style box (border, background) so it reads as a nav action,
	   not an input field — the data browser's search bar is the only
	   thing on the site that should look like one. */
	@media (min-width: 50rem) {
		.search-wrapper :global(button[data-open-modal]) {
			border: 0;
			background-color: transparent;
			padding-inline: 0;
			width: auto;
			color: var(--sl-color-gray-3);
			font-weight: 500;
			/* Icon only: sized to match the header's other icon buttons. */
			font-size: var(--sl-text-xl);
		}
		.search-wrapper :global(button[data-open-modal]:hover) {
			color: var(--sl-color-white);
		}
		/* Icon only; the shortcut still works and the dialog carries its
		   own labeling. */
		.search-wrapper :global(button[data-open-modal] > :not(svg)) {
			display: none;
		}
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::before {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	.site-menu {
		position: relative;
	}
	.site-menu summary {
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		cursor: pointer;
		color: var(--sl-color-gray-1);
	}
	.site-menu summary::-webkit-details-marker {
		display: none;
	}
	.site-menu svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.site-menu nav {
		position: absolute;
		inset-inline-end: 0;
		top: calc(100% + 0.5rem);
		min-width: 11rem;
		padding: 0.375rem;
		background-color: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-md);
	}
	.site-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-menu nav a {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.site-menu nav a:hover {
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.site-menu nav a[aria-current='page'] {
		background-color: var(--atb-sidebar-active-bg, var(--sl-color-gray-6));
		color: var(--atb-sidebar-active-text, var(--sl-color-white));
		font-weight: 600;
	}
</style>
