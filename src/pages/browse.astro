---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RuntimeEmbed from '../components/RuntimeEmbed.astro';

// The data browser is a React app maintained in the atb-explorer repo. Its
// deployment publishes a self-contained ES module with a stable name and a
// tiny contract — `mount(el, { assetBase }) -> unmount` — which this page
// imports at runtime via <RuntimeEmbed> below. App deploys go live here
// immediately, with no rebuild of this site. See atb-explorer's
// web/src/embed.tsx.
//
// PUBLIC_ATB_BROWSER_ORIGIN overrides the origin for local testing against a
// locally built bundle (e.g. `pnpm --filter web run preview` in atb-explorer).
const APP_ORIGIN =
	import.meta.env.PUBLIC_ATB_BROWSER_ORIGIN ?? 'https://atb-explorer-web.onrender.com';
const APP_BASE = `${APP_ORIGIN}/browse/`;
const APP_JS = `${APP_BASE}embed/atb-browser.js`;
---

<StarlightPage
	frontmatter={{
		title: 'Browse data',
		description:
			'Interactively explore AllTheBacteria samples by species, AMR genes, and metadata',
		template: 'splash',
		tableOfContents: false,
		// The docs page (/docs/data_browser/) is the searchable description
		// of the browser; keep the app shell itself out of the search index.
		pagefind: false,
		// RuntimeEmbed provides the stylesheet link and layer pin; these two
		// just warm the connection and the module fetch.
		head: [
			{ tag: 'link', attrs: { rel: 'preconnect', href: APP_ORIGIN, crossorigin: 'anonymous' } },
			// Module imports are CORS-mode requests; the preload must match.
			{ tag: 'link', attrs: { rel: 'modulepreload', href: APP_JS, crossorigin: 'anonymous' } },
		],
	}}
>
	<RuntimeEmbed
		js={APP_JS}
		css={`${APP_BASE}embed/atb-browser.css`}
		assetBase={APP_BASE}
		id="atb-browser"
		errorText="The data browser failed to load. Please check your connection and reload the page."
	/>
</StarlightPage>

<style is:global>
	/* This stylesheet only loads on /browse. The app wants an app-like
	   canvas: widen Starlight's splash content column for this page.
	   Specificity must beat Starlight's own splash-width rule,
	   `html:not([data-has-sidebar])` in Page.astro. */
	:root:not([data-has-sidebar]) {
		--sl-content-width: 87.5rem;
	}
	/* The app brings its own outer padding (p-6, same as its standalone
	   page); Starlight's content-panel padding would stack on top of it,
	   so drop it and let the app's spacing match the original exactly. */
	.content-panel {
		padding: 0;
	}
	/* Reserve space so the header/footer don't jump while the app loads.
	   Global because the div renders inside RuntimeEmbed. */
	#atb-browser {
		min-height: 60vh;
	}
</style>
